<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" href="/favicon.ico">
    <meta name="viewport" content="width=device-width">
    <meta name="generator" content={Astro.generator}>
    <meta
      name="description"
      content="chihiro のプロフィール、記事、登壇、コミュニティ、活動をまとめたサイトです。"
    >
    <title>nemumi</title>
  </head>
  <body>
    <div class="page-shell">
      <header class="site-header">
        <a class="wordmark" href="#top" aria-label="nemumi ホーム">
          <span class="wordmark-star" aria-hidden="true">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M20.8 15.7A9.3 9.3 0 0 1 8.3 3.2a9.5 9.5 0 1 0 12.5 12.5Z"
              />
            </svg>
          </span>
          <span>nemumi</span>
        </a>
        <nav aria-label="メインナビゲーション">
          <a href="#records">記事・活動</a>
          <a href="#talks">登壇</a>
          <a href="#communities">コミュニティ</a>
        </nav>
        <span class="header-note"
          ><span></span>
          DESIGN MOCKUP · CONTENT IS SAMPLE</span
        >
      </header>

      <main id="top">
        <section class="hero" aria-labelledby="profile-title">
          <div class="hero-copy">
            <p class="eyebrow">
              <span class="eyebrow-line"></span>
              A LITTLE CORNER OF THE INTERNET
            </p>
            <h1 id="profile-title">
              好きなことを、<br><span>ゆっくり集めて。</span>
            </h1>
            <p class="hero-intro">
              こんにちは、<strong>chihiro</strong>
              です。<br>
              長野を拠点に、PHPやGoでWebサイトをつくったり、スクラムやXPを試したり。コミュニティ運営もしています。
            </p>
            <nav class="social-links" aria-label="プロフィールリンク">
              <a href="https://x.com/chiroruxxxx" aria-label="X">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    d="M18.9 2H22l-6.78 7.75L23.2 22h-6.25l-4.9-7.45L5.53 22H2.4l7.25-8.29L1.8 2h6.4l4.42 6.94L18.9 2Zm-1.1 18h1.73L7.27 3.9H5.42L17.8 20Z"
                  />
                </svg>
                X <span aria-hidden="true">↗</span>
              </a>
              <a href="https://mixi.social/@chihiroxx" aria-label="mixi2">
                <span class="mixi2-mark" aria-hidden="true">m</span>
                mixi2 <span aria-hidden="true">↗</span>
              </a>
              <a href="https://github.com/chiroruxx" aria-label="GitHub">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    d="M12 2.4a9.7 9.7 0 0 0-3.07 18.9c.49.09.66-.21.66-.47v-1.68c-2.69.59-3.26-1.14-3.26-1.14-.44-1.12-1.08-1.42-1.08-1.42-.88-.6.07-.59.07-.59.97.07 1.48.99 1.48.99.86 1.47 2.26 1.04 2.81.79.09-.62.34-1.04.61-1.28-2.15-.25-4.42-1.08-4.42-4.79 0-1.06.38-1.93.99-2.61-.1-.24-.43-1.24.09-2.58 0 0 .81-.26 2.67.99a9.3 9.3 0 0 1 4.86 0c1.86-1.25 2.67-.99 2.67-.99.53 1.34.2 2.34.1 2.58.62.68.98 1.55.98 2.61 0 3.72-2.27 4.54-4.43 4.78.35.31.66.9.66 1.82v2.71c0 .26.17.56.67.46A9.7 9.7 0 0 0 12 2.4Z"
                  />
                </svg>
                GitHub <span aria-hidden="true">↗</span>
              </a>
            </nav>
          </div>
          <div class="profile-art">
            <div class="avatar-halo"></div>
            <img
              class="avatar-disc"
              src="/images/profile-icon.jpg"
              alt="chihiro のプロフィールアイコン"
              width="400"
              height="400"
              fetchpriority="high"
            >
            <span class="art-caption" aria-hidden="true">PROFILE ICON</span>
          </div>
        </section>

        <section
          class="content-section"
          id="records"
          aria-labelledby="records-title"
        >
          <div class="section-heading">
            <div>
              <h2 id="records-title">日々のこと</h2>
            </div>
            <p class="section-aside">書いたものと、<br>参加した活動の記録。</p>
          </div>
          <RecordList items={records} />
        </section>

        <section
          class="content-section talks-section"
          id="talks"
          aria-labelledby="talks-title"
        >
          <div class="section-heading">
            <div>
              <h2 id="talks-title">お話ししたこと</h2>
            </div>
            <p class="section-aside">
              会場で交わした話と、<br>あとから読めるスライド。
            </p>
          </div>
          <RecordList items={talkRecords} />
        </section>

        <section
          class="content-section community-section"
          id="communities"
          aria-labelledby="communities-title"
        >
          <div class="section-heading">
            <div>
              <h2 id="communities-title">コミュニティのこと</h2>
            </div>
            <p class="section-aside">
              ひとりでは見つからない、<br>景色に出会える場所。
            </p>
          </div>
          <div class="community-grid">
            {communities.map((community) => (
  <a class="community-card" href={community.url}>
    <div
      class:list={["community-icon", community.tone, community.imageStyle]}
      style={
        community.imageBackground &&
        `--community-image-background: ${community.imageBackground}`
      }
      role="img"
      aria-label={`${community.name}のアイコン`}
    >
      {community.image ? (
        <img
          class:list={["community-icon-image", community.imageStyle]}
          src={community.image}
          alt=""
          width={community.imageStyle === "wordmark" ? 162 : 110}
          height="110"
          loading="lazy"
        />
      ) : (
        <span aria-hidden="true">{community.icon}</span>
      )}
    </div>
    <div class="community-info">
      <h3>{community.name}</h3>
      <p>{community.description}</p>
    </div>
  </a>
))}
          </div>
        </section>
      </main>

      <footer class="site-footer">
        <a class="wordmark" href="#top"
          ><span class="wordmark-star" aria-hidden="true">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M20.8 15.7A9.3 9.3 0 0 1 8.3 3.2a9.5 9.5 0 1 0 12.5 12.5Z"
              />
            </svg>
          </span
          >nemumi</a
        >
        <small>© 2026 chihiro</small>
      </footer>
    </div>
  </body>
</html>

<style>
@import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;600;700&display=swap");

:root {
  color-scheme: dark;
  --ink: #f1efff;
  --paper: #1c1b32;
  --line: #403e59;
  --gold: #f7d99a;
  --motion-duration: 200ms;
  font-family: "DM Sans", "Noto Sans JP", sans-serif;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}
html {
  scroll-behavior: smooth;
  background: var(--paper);
}
body {
  position: relative;
  margin: 0;
  color: var(--ink);
  background-color: #1c1b32;
  background-image:
    radial-gradient(circle at 18px 29px, #e8ddff61 0 1px, transparent 1.5px),
    radial-gradient(circle at 113px 91px, #cfc5ff61 0 1px, transparent 1.5px),
    radial-gradient(circle at 238px 172px, #fff1c861 0 1.2px, transparent 1.8px),
    radial-gradient(circle at 73px 247px, #ded7ff61 0 0.8px, transparent 1.5px),
    radial-gradient(ellipse at 50% 0%, #302d50 0, transparent 43rem);
  background-size:
    293px 319px,
    293px 319px,
    293px 319px,
    293px 319px,
    auto;
  background-repeat: repeat, repeat, repeat, repeat, no-repeat;
}
a {
  color: inherit;
  text-decoration: none;
}
a:focus-visible {
  outline: 3px solid #9886dc;
  outline-offset: 5px;
  border-radius: 4px;
}
.page-shell {
  position: relative;
  z-index: 1;
  max-width: 1600px;
  margin: 0 auto;
  overflow: hidden;
  background: transparent;
}

.site-header {
  height: 82px;
  padding: 0 clamp(24px, 6.2vw, 100px);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
  background: transparent;
}
.wordmark {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  color: #f1efff;
  font-size: 19px;
  font-weight: 700;
  letter-spacing: -0.045em;
}
.wordmark-star {
  display: inline-grid;
  place-items: center;
  color: #f1cf72;
}
.wordmark-star svg {
  width: 19px;
  height: 19px;
  fill: currentColor;
}
nav {
  display: flex;
  align-items: center;
  gap: clamp(18px, 3vw, 42px);
}
nav a {
  color: #c0bdd4;
  font-size: 12px;
  transition: color var(--motion-duration) ease;
}
nav a:hover {
  color: #8c77d0;
}
.header-note {
  color: #aaa7c1;
  font-size: 10px;
  letter-spacing: 0.08em;
}
.header-note span {
  display: inline-block;
  width: 6px;
  height: 6px;
  margin: 0 7px 1px 0;
  border-radius: 50%;
  background: #a99ad9;
}

.hero {
  position: relative;
  min-height: 590px;
  margin: 0 24px;
  padding: 80px clamp(28px, 8vw, 130px) 76px;
  display: flex;
  align-items: center;
  overflow: hidden;
  border: 1px solid #4b486b;
  border-radius: 8px;
  color: #fbf9ff;
  background: radial-gradient(
    ellipse at 76% 48%,
    #484465 0,
    #373451 48%,
    #302f4c 100%
  );
  box-shadow: 0 22px 70px #0e0d1c66;
}
.hero::before {
  position: absolute;
  inset: 0;
  content: "";
  opacity: 0.08;
  background-image: radial-gradient(#fff 0.7px, transparent 0.7px);
  background-size: 23px 23px;
  mask-image: linear-gradient(90deg, transparent 20%, #000 100%);
}
.hero-copy {
  position: relative;
  z-index: 2;
  width: 55%;
  padding-bottom: 30px;
}
.eyebrow {
  margin: 0;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.18em;
}
.eyebrow {
  display: flex;
  align-items: center;
  gap: 11px;
  color: #c9c3e4;
}
.eyebrow-line {
  width: 27px;
  height: 1px;
  background: #b6a9e7;
}
h1 {
  margin: 27px 0 21px;
  font-size: clamp(42px, 5.4vw, 72px);
  font-weight: 500;
  line-height: 1.38;
  letter-spacing: 0.02em;
}
.hero-copy h1 span {
  color: #d6cafa;
}
.hero-intro {
  color: #d4d2e1;
  font-size: 14px;
  line-height: 2.1;
  letter-spacing: 0.025em;
}
.hero-intro strong {
  color: white;
  font-weight: 600;
}
.social-links {
  display: flex;
  gap: 11px;
  margin-top: 27px;
}
.social-links a {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 14px;
  border: 1px solid #696782;
  border-radius: 99px;
  color: #eeedf5;
  font-size: 11px;
  transition:
    background var(--motion-duration) ease,
    border var(--motion-duration) ease;
}
.social-links a:hover {
  border-color: #c7b8f2;
  background: #ffffff12;
}
.social-links svg {
  width: 13px;
  height: 13px;
  fill: currentColor;
}
.social-links a .mixi2-mark {
  display: grid;
  width: 14px;
  height: 14px;
  margin-left: 0;
  place-items: center;
  border-radius: 4px;
  color: #36324e;
  background: #ded3ff;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0;
}
.social-links a span {
  margin-left: 3px;
  color: #bfb5e7;
}
.profile-art {
  position: absolute;
  z-index: 1;
  top: 50%;
  right: clamp(50px, 11vw, 180px);
  width: min(26vw, 300px);
  aspect-ratio: 1;
  transform: translateY(-53%);
}
.avatar-halo {
  position: absolute;
  inset: 0;
  border: 1px solid #aaa1d04a;
  border-radius: 50%;
}
.avatar-halo::before,
.avatar-halo::after {
  position: absolute;
  content: "";
  border: 1px solid #aaa1d02e;
  border-radius: 50%;
}
.avatar-halo::before {
  inset: 13%;
}
.avatar-halo::after {
  inset: -11%;
  border-style: dashed;
  opacity: 0.5;
}
.avatar-disc {
  position: absolute;
  top: 20%;
  left: 20%;
  width: 60%;
  height: 60%;
