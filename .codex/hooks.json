{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/biome-check.sh\"",
            "timeout": 60,
            "statusMessage": "Biome で整形・Lint 中..."
          }
        ]
      }
    ]
  }
}
