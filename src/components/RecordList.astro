---
interface Item {
  date: string;
  datetime: string;
  detail: string;
  title: string;
  url?: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<ol class="record-list">
  {items.map((item) => (
  <li>
    {item.url ? (
      <a class="record-row record-row-link" href={item.url}>
        <time datetime={item.datetime}>{item.date}</time>
        <span class="record-detail">{item.detail}</span>
        <span class="record-title">{item.title}</span>
        <span class="row-arrow" aria-hidden="true">
          ↗
        </span>
      </a>
    ) : (
      <div class="record-row">
        <time datetime={item.datetime}>{item.date}</time>
        <span class="record-detail">{item.detail}</span>
        <span class="record-title">{item.title}</span>
      </div>
    )}
  </li>
))}
</ol>

<style>
.record-list {
  margin: 0;
  padding: 0;
  border-top: 1px solid var(--line);
  list-style: none;
}
.record-row {
  min-height: 69px;
  display: grid;
  grid-template-columns: 150px 150px 1fr 22px;
  align-items: center;
  gap: 15px;
  border-bottom: 1px solid var(--line);
}
.record-row-link {
  color: inherit;
  text-decoration: none;
  transition:
    padding var(--motion-duration) ease,
    background var(--motion-duration) ease;
}
.record-row-link:hover {
  padding-right: 8px;
  padding-left: 8px;
  background: #292743;
}
.record-row-link:focus-visible {
  outline: 3px solid #9886dc;
  outline-offset: 3px;
  border-radius: 4px;
}
.record-row time {
  color: #aaa6bd;
  font-size: 10px;
  letter-spacing: 0.05em;
}
.record-detail {
  justify-self: start;
  padding: 4px 8px;
  border-radius: 99px;
  color: #d0c5ef;
  background: #36334f;
  font-size: 9px;
  white-space: nowrap;
}
.record-title {
  color: #eeecfb;
  font-size: 12px;
  font-weight: 500;
}
.row-arrow {
  color: #c3b5ea;
  font-size: 16px;
  text-align: right;
}

@media (max-width: 760px) {
  .record-row {
    grid-template-columns: 112px 145px 1fr 15px;
    gap: 8px;
    min-height: 65px;
  }
  .record-row time {
    font-size: 9px;
  }
  .record-detail {
    font-size: 8px;
  }
  .record-title {
    font-size: 10px;
  }
}

@media (max-width: 480px) {
  .record-row {
    grid-template-columns: 94px 1fr 12px;
    grid-template-rows: auto auto;
    gap: 7px 6px;
    padding: 12px 0;
  }
  .record-row time {
    grid-row: 1 / 3;
    font-size: 8px;
  }
  .record-detail,
  .record-title {
    grid-column: 2;
  }
  .record-detail {
    padding: 4px 6px;
    font-size: 7px;
  }
  .record-title {
    font-size: 9px;
  }
  .row-arrow {
    grid-column: 3;
    grid-row: 1 / 3;
  }
}
</style>
