---
interface Props {
  startDate: Date;
  endDate?: Date;
  tags: string[];
  title: string;
}

const { startDate, endDate, tags, title } = Astro.props;
const formatDate = (date: Date) =>
  Temporal.Instant.fromEpochMilliseconds(date.getTime())
    .toZonedDateTimeISO('UTC')
    .toPlainDate()
    .toString();
const formattedStartDate = formatDate(startDate);
const formattedEndDate = endDate ? formatDate(endDate) : undefined;
---

<span class="record-date">
  <time datetime={formattedStartDate}>{formattedStartDate}</time>
  {formattedEndDate && (
    <>
      – <time datetime={formattedEndDate}>{formattedEndDate}</time>
    </>
  )}
</span>
<span class="record-tags">
  {tags.map((tag) => <span class="record-tag">{tag}</span>)}
</span>
<span class="record-title">{title}</span>

<style>
.record-date time {
  color: var(--color-on-background-weak);
  font-size: 10px;
  letter-spacing: 0.05em;
}

.record-tags {
  display: flex;
  justify-self: start;
  flex-wrap: wrap;
  gap: 6px;
}

.record-tag {
  padding: 4px 8px;
  border-radius: 99px;
  color: var(--color-on-surface-weak);
  background: var(--color-surface);
  font-size: 9px;
  white-space: nowrap;
}

.record-title {
  color: var(--color-on-background);
  font-size: 12px;
  font-weight: 500;
}

@media (width <= 760px) {
  .record-date time {
    font-size: 9px;
  }

  .record-tag {
    font-size: 8px;
  }

  .record-title {
    font-size: 10px;
  }
}

@media (width <= 480px) {
  .record-date {
    grid-row: 1 / 3;

    time {
      font-size: 8px;
    }
  }

  .record-tags,
  .record-title {
    grid-column: 2;
  }

  .record-tag {
    padding: 4px 6px;
    font-size: 7px;
  }

  .record-title {
    font-size: 9px;
  }
}
</style>
