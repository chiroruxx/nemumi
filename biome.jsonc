{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!!.codex/hooks.json", "!!**/dist"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    // 無効化コメントの理由は Biome の構文で必須。追加の設定は不要。
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": "error",
        "useArraySome": "error",
        "useRegexpTest": "error"
      },
      "suspicious": {
        "noLoopFunc": "error"
      },
      "nursery": {
        "noArgumentsCallerOrCallee": "error",
        "noExcessiveStatementsPerFunction": "error",
        "noInvalidThis": "error",
        "noNestedSwitch": "error",
        "noNestedTemplateLiterals": "error",
        "noOctal": "error",
        "noUnsafeUnaryMinus": "error",
        "noZeroFractions": "error",
        "useBigintLiterals": "error",
        "useConsistentJsonFileRead": "error",
        "useLowercaseTestTitle": "error",
        "useNamedFunction": "error",
        "useUnaryMinus": "error"
      },
      "style": {
        "noUselessElse": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "markdown": {
    "parser": {
      "frontmatter": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true
    }
  },
  "overrides": [
    // pnpm が生成する形式を維持し、依存更新のたびに整形差分が発生するのを防ぐ。
    {
      "includes": ["pnpm-lock.yaml"],
      "formatter": {
        "enabled": false
      }
    },
    // テストでは準備・操作・検証を一連のシナリオとして記述するため、文数の上限を適用しない。
    {
      "includes": ["tests/**"],
      "linter": {
        "rules": {
          "nursery": {
            "noExcessiveStatementsPerFunction": "off"
          }
        }
      }
    },
    // Astro 内の CSS Lint は Stylelint に集約するため、Biome では無効にする。
    {
      "includes": ["src/**/*.astro"],
      "css": {
        "linter": {
          "enabled": false
        }
      }
    },
    // SVG は favicon などの画像として使うため、SVG 内の title 要素を必須にしない。
    {
      "includes": ["public/**/*.svg"],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "off"
          }
        }
      }
    }
  ]
}
