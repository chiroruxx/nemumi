---
import { getCollection } from 'astro:content';
import profileIcon from '../assets/profile-icon.png';
import Hero from '../components/Hero.astro';
import LinkCard from '../components/LinkCard.astro';
import RecordList from '../components/RecordList.astro';
import Wordmark from '../components/Wordmark.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const [articleEntries, talkEntries, communityEntries, activityEntries] =
  await Promise.all([
    getCollection('articles'),
    getCollection('talks'),
    getCollection('communities'),
    getCollection('activities'),
  ]);

const articles = articleEntries.map(({ data }) => ({
  startDate: data.date,
  tags: [data.service],
  title: data.title,
  url: data.url,
}));

const talkRecords = talkEntries
  .map(({ data }) => ({
    startDate: data.date,
    tags: ['登壇'],
    title: data.title,
    url: data.url,
  }))
  .sort((a, b) => b.startDate.getTime() - a.startDate.getTime());

const communities = communityEntries
  .sort((a, b) => a.data.order - b.data.order)
  .map(({ data }) => data);

const records = [
  ...articles,
  ...activityEntries.map(({ data }) => ({
    startDate: data.startDate,
    endDate: data.endDate,
    tags: data.types,
    title: data.title,
    url: data.url,
  })),
].sort((a, b) => b.startDate.getTime() - a.startDate.getTime());

const profileSocialLinks = [
  {
    href: 'https://x.com/chiroruxxxx',
    label: 'X',
    icon: '/icons/social-x.svg',
  },
  {
    href: 'https://mixi.social/@chihiroxx',
    label: 'mixi2',
    icon: '/icons/social-mixi2.svg',
  },
  {
    href: 'https://github.com/chiroruxx',
    label: 'GitHub',
    icon: '/icons/social-github.svg',
  },
];
---

<BaseLayout
  title="nemumi"
  description="chihiro のプロフィール、記事、登壇、コミュニティ、活動をまとめたサイトです。"
>
  <header class="site-header">
    <Wordmark href="#top" label="nemumi ホーム" />
    <nav aria-label="メインナビゲーション">
      <a href="#records">記事・活動</a>
      <a href="#talks">登壇</a>
      <a href="#communities">コミュニティ</a>
    </nav>
  </header>

  <main id="top">
    <Hero
      eyebrow="A LITTLE CORNER OF THE INTERNET"
      headline={{ firstLine: '好きなことを、', highlightedLine: 'ゆっくり集めて。' }}
      name="chihiro"
      introduction="長野を拠点に、PHPやGoでWebサイトをつくったり、スクラムやXPを試したり。コミュニティ運営もしています。"
      links={profileSocialLinks}
      linksLabel="プロフィールリンク"
      artwork={profileIcon}
      artworkAlt="chihiro のプロフィールアイコン"
    />

    <section
      class="content-section"
      id="records"
      aria-labelledby="records-title"
    >
      <div class="section-heading">
        <h2 id="records-title">日々のこと</h2>
        <p class="section-aside">書いたものと、<br>参加した活動の記録。</p>
      </div>
      <RecordList items={records} />
    </section>

    <section
      class="content-section talks-section"
      id="talks"
      aria-labelledby="talks-title"
    >
      <div class="section-heading">
        <h2 id="talks-title">お話ししたこと</h2>
        <p class="section-aside">
          会場で交わした話と、<br>あとから読めるスライド。
        </p>
      </div>
      <RecordList items={talkRecords} />
    </section>

    <section
      class="content-section community-section"
      id="communities"
      aria-labelledby="communities-title"
    >
      <div class="section-heading">
        <h2 id="communities-title">コミュニティのこと</h2>
        <p class="section-aside">
          ひとりでは見つからない、<br>景色に出会える場所。
        </p>
      </div>
      <div class="community-grid">
        {communities.map((community) => (
  <LinkCard
    title={community.name}
    url={community.url}
    description={community.description}
    image={community.image}
    imageStyle={community.imageStyle}
    imageBackground={community.imageBackground}
  />
))}
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <Wordmark href="#top" label="nemumi トップへ" />
    <small>© 2026 chihiro</small>
  </footer>
</BaseLayout>

<style>
.site-header {
  height: 82px;
  padding: 0 clamp(24px, 6.2vw, 100px);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
  nav {
    display: flex;
    align-items: center;
    gap: clamp(18px, 3vw, 42px);
    a {
      color: var(--color-on-background);
      font-size: 12px;
      transition: color var(--motion-duration) ease;
      &:hover {
        color: var(--color-primary);
      }
    }
  }
  @media (width <= 760px) {
    height: 70px;
    padding: 0 23px;
    nav {
      gap: 15px;
      a {
        font-size: 10px;
      }
    }
  }
  @media (width <= 480px) {
    padding: 0 17px;
    nav {
      gap: 10px;
      a {
        font-size: 9px;
      }
    }
  }
}
.content-section {
  padding: 112px clamp(28px, 12vw, 190px) 0;
  &.talks-section {
    padding-top: 117px;
  }
  &.community-section {
    padding-top: 116px;
    padding-bottom: 118px;
  }
  @media (width <= 760px) {
    padding: 82px 27px 0;
  }
}
.section-heading {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 34px;
  h2 {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.45em;
    color: var(--color-on-background-strong);
    font-size: clamp(26px, 3vw, 36px);
    font-weight: 500;
    letter-spacing: 0.04em;
    &::before {
      color: var(--color-secondary);
      content: "☆";
      font-size: 0.52em;
    }
  }
  @media (width <= 760px) {
    margin-bottom: 24px;
  }
  @media (width <= 480px) {
    align-items: start;
  }
}
.section-aside {
  margin: 0 0 3px;
  color: var(--color-on-background);
  font-size: 11px;
  line-height: 1.9;
  text-align: right;
  @media (width <= 760px) {
    font-size: 10px;
  }
  @media (width <= 480px) {
    padding-top: 4px;
    font-size: 9px;
  }
}
.community-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
  @media (width <= 760px) {
    grid-template-columns: 1fr;
    gap: 12px;
  }
}
.site-footer {
  min-height: 100px;
  padding: 24px clamp(28px, 6.2vw, 100px);
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;
  gap: 15px;
  border-top: 1px solid var(--color-outline);
  small {
    grid-column: 2;
    color: var(--color-on-background-weak);
    font-size: 9px;
    text-align: right;
  }
  @media (width <= 760px) {
    padding: 25px 24px;
  }
}
</style>
