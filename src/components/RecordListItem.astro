---
import type { ComponentProps } from 'astro/types';
import RecordListItemContent from './RecordListItemContent.astro';

interface Props extends ComponentProps<typeof RecordListItemContent> {
  url?: URL;
}

const { url, ...content } = Astro.props;
---

{url ? (
  <a
    class="record-row record-row-link"
    href={url.href}
    target="_blank"
    rel="noopener noreferrer"
  >
    <RecordListItemContent {...content} />
    <span class="row-arrow" aria-hidden="true">
      ↗
    </span>
  </a>
) : (
  <div class="record-row">
    <RecordListItemContent {...content} />
  </div>
)}

<style>
.record-row {
  min-height: 69px;
  display: grid;
  grid-template-columns: 150px 150px 1fr 22px;
  align-items: center;
  gap: 15px;
  border-bottom: 1px solid var(--color-outline);

  &.record-row-link {
    color: inherit;
    text-decoration: none;
    transition:
      padding var(--motion-duration) ease,
      background var(--motion-duration) ease;

    &:hover {
      padding-right: 8px;
      padding-left: 8px;
      background: var(--color-surface-hover);
    }

    &:focus-visible {
      background: var(--color-surface-focus);
      outline: 3px solid var(--color-focus);
      outline-offset: 3px;
      border-radius: 4px;
    }
  }

  .row-arrow {
    color: var(--color-primary);
    font-size: 16px;
    text-align: right;
  }

  @media (width <= 760px) {
    grid-template-columns: 112px 145px 1fr 15px;
    gap: 8px;
    min-height: 65px;
  }

  @media (width <= 480px) {
    grid-template-columns: 94px 1fr 12px;
    grid-template-rows: auto auto;
    gap: 7px 6px;
    padding: 12px 0;

    .row-arrow {
      grid-column: 3;
      grid-row: 1 / 3;
    }
  }
}
</style>
