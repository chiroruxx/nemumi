---
import type { ComponentProps } from 'astro/types';
import RecordListItem from './RecordListItem.astro';

interface Props {
  items: ComponentProps<typeof RecordListItem>[];
}

const { items } = Astro.props;
---

<ol class="record-list">
  {items.map((item) => (
    <li>
      <RecordListItem
        startDate={item.startDate}
        endDate={item.endDate}
        tags={item.tags}
        title={item.title}
        url={item.url}
      />
    </li>
  ))}
</ol>

<style>
.record-list {
  margin: 0;
  padding: 0;
  border-top: 1px solid var(--color-outline);
  list-style: none;
}
</style>
