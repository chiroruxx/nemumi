{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write|Bash|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/biome-check.sh\"",
            "timeout": 60,
            "statusMessage": "変更ファイルのBiomeチェック中..."
          }
        ]
      }
    ]
  }
}
