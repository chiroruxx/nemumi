---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { ComponentProps } from 'astro/types';
import IconLink from './IconLink.astro';

type IconLinkItem = ComponentProps<typeof IconLink>;

interface Props {
  eyebrow: string;
  headline: {
    firstLine: string;
    highlightedLine: string;
  };
  name: string;
  introduction: string;
  links: IconLinkItem[];
  linksLabel: string;
  artwork: ImageMetadata;
  artworkAlt: string;
}

const {
  eyebrow,
  headline,
  name,
  introduction,
  links,
  linksLabel,
  artwork,
  artworkAlt,
} = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow">
      <span class="eyebrow-line"></span>
      {eyebrow}
    </p>
    <h1 id="hero-title">
      {headline.firstLine}<br><span>{headline.highlightedLine}</span>
    </h1>
    <p class="hero-intro">
      こんにちは、<strong>{name}</strong>
      です。<br>
      {introduction}
    </p>
    <nav class="icon-links" aria-label={linksLabel}>
      {links.map((link) => (
  <IconLink href={link.href} label={link.label} icon={link.icon} />
))}
    </nav>
  </div>
  <div class="hero-art">
    <div class="hero-art-halo"></div>
    <div class="hero-art-image">
      <Image
        src={artwork}
        alt={artworkAlt}
        width={320}
        height={320}
        style="display: block; width: 100%; height: 100%; object-fit: cover"
        quality={85}
        fetchpriority="high"
        loading="eager"
      />
    </div>
  </div>
</section>

<style>
.hero {
  position: relative;
  min-height: 590px;
  margin: 0 24px;
  padding: 80px clamp(28px, 8vw, 130px) 76px;
  display: flex;
  align-items: center;
  overflow: hidden;
  border: 1px solid var(--color-outline);
  border-radius: 8px;
  color: var(--color-on-surface-strong);
  background: radial-gradient(
    ellipse at 76% 48%,
    color-mix(in srgb, var(--color-surface) 80%, var(--color-primary)) 0,
    color-mix(in srgb, var(--color-surface) 93%, var(--color-primary)) 48%,
    var(--color-surface) 100%
  );
  box-shadow: 0 22px 70px var(--decoration-shadow);
  &::before {
    position: absolute;
    inset: 0;
    content: "";
    opacity: 0.08;
    background-image: radial-gradient(
      var(--decoration-white) 0.7px,
      transparent 0.7px
    );
    background-size: 23px 23px;
    mask-image: linear-gradient(
      90deg,
      transparent 20%,
      var(--decoration-mask-black) 100%
    );
  }
  .hero-copy {
    position: relative;
    z-index: 2;
    width: 55%;
    padding-bottom: 30px;
    .eyebrow {
      display: flex;
      align-items: center;
      gap: 11px;
      margin: 0;
      color: var(--color-on-surface);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.18em;
    }
    .eyebrow-line {
      width: 27px;
      height: 1px;
      background: var(--color-primary);
    }
    h1 {
      margin: 27px 0 21px;
      font-size: clamp(42px, 5.4vw, 72px);
      font-weight: 500;
      line-height: 1.38;
      letter-spacing: 0.02em;
      span {
        color: var(--color-primary);
      }
    }
    .hero-intro {
      color: var(--color-on-surface);
      font-size: 14px;
      line-height: 2.1;
      letter-spacing: 0.025em;
      strong {
        color: var(--color-on-surface-strong);
        font-weight: 600;
      }
    }
    .icon-links {
      display: flex;
      gap: 11px;
      margin-top: 27px;
    }
  }
  .hero-art {
    position: absolute;
    z-index: 1;
    top: 50%;
    right: clamp(50px, 11vw, 180px);
    width: min(26vw, 300px);
    aspect-ratio: 1;
    transform: translateY(-53%);
    .hero-art-halo {
      position: absolute;
      inset: 0;
      border: 1px solid
        color-mix(in srgb, var(--color-primary) 29%, transparent);
      border-radius: 50%;
      &::before,
      &::after {
        position: absolute;
        content: "";
        border: 1px solid
          color-mix(in srgb, var(--color-primary) 18%, transparent);
        border-radius: 50%;
      }
      &::before {
        inset: 13%;
      }
      &::after {
        inset: -11%;
        border-style: dashed;
        opacity: 0.5;
      }
    }
    .hero-art-image {
      position: absolute;
      top: 20%;
      left: 20%;
      width: 60%;
      height: 60%;
      border: 1px solid
        color-mix(in srgb, var(--color-primary) 46%, transparent);
      border-radius: 50%;
      overflow: hidden;
      background: var(--color-surface);
      box-shadow:
        0 0 70px color-mix(in srgb, var(--color-primary) 14%, transparent),
        inset 0 0 34px color-mix(in srgb, var(--color-primary) 11%, transparent);
    }
  }
  @media (width >= 1200px) {
    margin-right: 40px;
    margin-left: 40px;
  }
  @media (width <= 900px) {
    min-height: auto;
    padding-bottom: 84px;
    flex-direction: column;
    align-items: stretch;
    .hero-copy {
      width: 100%;
      max-width: 580px;
    }
    .hero-art {
      position: relative;
      top: auto;
      right: auto;
      bottom: auto;
      width: clamp(170px, 25vw, 205px);
      margin: 10px auto 0;
      transform: none;
    }
  }
  @media (width <= 760px) {
    margin: 0 12px;
    padding: 50px 26px 66px;
    align-items: start;
    .hero-copy {
      width: 100%;
      padding-top: 15px;
      h1 {
        margin-top: 21px;
        font-size: clamp(40px, 10vw, 60px);
      }
      .hero-intro {
        font-size: 12px;
      }
    }
    .hero-art {
      width: min(42vw, 210px);
      margin-top: 16px;
    }
  }
  @media (width <= 480px) {
    min-height: 665px;
    padding-right: 22px;
    padding-left: 22px;
    .hero-copy {
      .eyebrow {
        font-size: 8px;
      }
      .hero-intro {
        max-width: 290px;
      }
    }
    .hero-art {
      width: 170px;
    }
  }
}
</style>
