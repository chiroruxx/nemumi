---
interface Props {
  href: string;
  label: string;
  icon: string;
}

const { href, label, icon } = Astro.props;
---

<a
  class="icon-link"
  href={href}
  aria-label={label}
  target="_blank"
  rel="noopener noreferrer"
>
  <span class="icon-link-icon-frame">
    {/* The mixi2 brand guideline sets the symbol's digital minimum height to 16px. */}
    <img class="icon-link-icon" src={icon} alt="" width="16" height="16">
  </span>
  <span class="icon-link-label">{label}</span>
  <span class="icon-link-arrow" aria-hidden="true">↗</span>
</a>

<style>
.icon-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 14px;
  border: 1px solid var(--color-outline-variant);
  border-radius: 99px;
  color: var(--color-on-surface-strong);
  font-size: 11px;
  transition:
    background var(--motion-duration) ease,
    border var(--motion-duration) ease;

  &:hover {
    border-color: var(--color-outline-variant);
    background: var(--color-surface-hover);
    color: var(--color-primary);
  }

  &:focus-visible {
    background: var(--color-surface-focus);
  }

  .icon-link-icon {
    display: block;
    width: auto;

    /* The mixi2 brand guideline sets the symbol's digital minimum height to 16px. */
    height: 16px;
  }

  .icon-link-icon-frame {
    display: inline-flex;
    flex: 0 0 auto;

    /*
     * The mixi2 brand guideline uses logotype x as clear space: 16px × (49.328 / 310) ≈ 2.55px.
     * Round up to 3px so spacing does not fall below the minimum.
     */
    padding: 3px;
  }

  .icon-link-arrow {
    margin-left: 3px;
    color: var(--color-on-surface);
  }
}
</style>
