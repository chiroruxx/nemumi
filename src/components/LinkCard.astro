---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  url: string;
  description: string;
  image: ImageMetadata;
  imageStyle: 'wordmark' | 'square';
  imageBackground?: string;
}

const { title, url, description, image, imageStyle, imageBackground } =
  Astro.props;
const imageSize = Math.min(image.width, 320);
const imageHeight = Math.round((imageSize * image.height) / image.width);
---

<article>
  <a class="link-card" href={url} target="_blank" rel="noopener noreferrer">
    <div
      class:list={['link-card-image', imageStyle]}
      style={imageBackground && `--link-card-image-background: ${imageBackground}`}
      aria-hidden="true"
    >
      <Image
        class={`link-card-image-content ${imageStyle}`}
        src={image}
        alt=""
        width={imageSize}
        height={imageHeight}
        format="webp"
        quality={85}
        loading="lazy"
      />
    </div>
    <div class="link-card-content">
      <h3>{title}</h3>
      <p>{description}</p>
    </div>
  </a>
</article>

<style>
.link-card {
  position: relative;
  min-height: 200px;
  padding: 22px 24px;
  display: grid;
  grid-template-columns: 112px 1fr;
  align-items: center;
  gap: 22px;
  border-radius: 5px;
  background: var(--color-surface);
  color: inherit;
  transition:
    background var(--motion-duration) ease,
    box-shadow var(--motion-duration) ease,
    transform var(--motion-duration) ease;

  &:hover {
    background: var(--color-surface-hover);
    box-shadow: 0 12px 30px var(--decoration-shadow);
    transform: scale(0.98);
  }
  &:focus-visible {
    background: var(--color-surface-focus);
  }

  h3 {
    margin: 0 0 8px;
    color: var(--color-on-surface-strong);
    font-size: 16px;
    font-weight: 500;
  }
  p {
    max-width: 350px;
    margin: 0;
    color: var(--color-on-surface);
    font-size: 11px;
    line-height: 1.9;
  }
  .link-card-image {
    --link-card-image-background: var(--decoration-white);
    display: grid;
    width: 112px;
    aspect-ratio: 1;
    place-items: center;
    overflow: hidden;
    border-radius: 32px;
    background: var(--link-card-image-background);
  }
  .link-card-image-content {
    width: 100%;
    height: 100%;
    object-fit: contain;
    &.wordmark {
      padding: 10px;
      background: var(--link-card-image-background);
    }
    &.square {
      object-fit: cover;
    }
  }
  .link-card-content {
    min-width: 0;
  }
  @media (width <= 760px) {
    min-height: 200px;
    grid-template-columns: 90px 1fr;
    gap: 16px;
    padding: 18px;
    .link-card-image {
      width: 90px;
      border-radius: 26px;
    }
  }
}
</style>
